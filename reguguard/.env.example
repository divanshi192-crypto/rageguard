# Copy to .env.local for local dev, or set in Vercel / hosting dashboard.

# Local backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production — same value as your Render web service URL (no trailing slash).
# Default from render.yaml service name `reguguard-api`:
# NEXT_PUBLIC_API_URL=https://reguguard-api.onrender.com
